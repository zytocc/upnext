{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && node scripts/demo-build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/generated/api.ts",
    "licenses": "node scripts/licenses.mjs",
    "demo:record": "node scripts/demo-record.mjs",
    "demo:check": "node scripts/demo-record.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
